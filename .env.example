# 后端/报告中展示的品牌名称。模板默认使用中性名称，业务项目可自行覆盖。
APP_BRAND_NAME=DWT Testing
# 后端/报告中展示的产品名称。
APP_PRODUCT_NAME=DWT Testing
# 前端页面展示的品牌名称。
VITE_APP_BRAND_NAME=DWT Testing
# 前端页面展示的产品名称。
VITE_APP_PRODUCT_NAME=DWT Testing

# 当前默认测试环境标识。
TEST_ENV=sit
# Node.js 运行模式。
NODE_ENV=development

# 用户端登录页地址。web-dowalet-admin 本地一般为 http://localhost:5173/#/login，SIT 一般为 https://sit.dowalet.com/user/#/login
USER_LOGIN_URL="https://sit.dowalet.com/user/#/login"
# 用户端注册页地址，注册类流程会直接打开该地址。含 # 的 URL 请保留引号或确保 env 解析器支持 hash 路由。
USER_REGISTER_URL="https://sit.dowalet.com/user/#/register"
# 用户端首页地址。
USER_HOME_URL=
# 用户端 KYC 页面地址。
USER_KYC_URL=
# 用户端测试账号。
USER_USERNAME=
# 用户端测试密码。
USER_PASSWORD=
# 注册流程默认密码。真实环境可按被测系统密码规则覆盖。
USER_REGISTER_PASSWORD=Test@12345
# 手机号注册流程的固定测试手机号。留空时由用例通过 139 + 时间戳后 8 位自动生成。
REGISTER_TEST_PHONE=

# 管理端登录页地址。若用例会在 login_url 后拼接 #/admin/...，建议配置为无 hash 的入口，例如 http://localhost:5173/admin/ 或 https://sit.dowalet.com/admin/
ADMIN_LOGIN_URL=http://localhost:5173/admin/
# 管理端首页地址。
ADMIN_HOME_URL=
# 管理端 KYC 审核页地址。
ADMIN_KYC_REVIEW_URL=
# 管理端测试账号。
ADMIN_USERNAME=
# 管理端测试密码。
ADMIN_PASSWORD=

# 自动生成 KYC 企业名称的前缀。
KYC_ENTERPRISE_NAME_PREFIX=自动化测试企业
# 自动生成营业执照号的前缀。
KYC_LICENSE_NO_PREFIX=AUTO
# KYC 法人姓名测试值。
KYC_LEGAL_PERSON=自动化测试法人
# KYC 法人身份证号测试值。
KYC_ID_CARD_NO=110101199001011234
# KYC 审核备注默认内容。
KYC_REVIEW_REMARK=自动化测试审核通过

# 营业执照上传文件路径。
KYC_BUSINESS_LICENSE_FILE=uploads/cases/kyc_submit/business-license.png
# 企业办公场景上传文件路径。
KYC_OFFICE_FILE=uploads/cases/kyc_submit/office-scene.png
# 身份证人像面上传文件路径。
KYC_ID_CARD_FRONT_FILE=uploads/cases/kyc_submit/id-card-front.png
# 身份证国徽面上传文件路径。
KYC_ID_CARD_BACK_FILE=uploads/cases/kyc_submit/id-card-back.png
# 手持身份证上传文件路径。
KYC_ID_CARD_HANDHELD_FILE=uploads/cases/kyc_submit/id-card-handheld.png
# 居住证明上传文件路径（选填）。
KYC_LIVE_PROVE_FILE=uploads/cases/kyc_submit/live-prove.png

# 是否启用接口测试能力。
API_ENABLED=false
# 接口测试基础地址。
API_BASE_URL=
# 接口测试基础地址别名，适合不同团队保留自己的命名习惯。
APP_API_BASE_URL=
# Dowalet 项目接口地址别名；优先级低于 API_BASE_URL / APP_API_BASE_URL。
DWT_API_BASE_URL=
# 通用测试接口地址别名；优先级低于 DWT_API_BASE_URL。
TEST_API_BASE_URL=
# 接口测试鉴权 token。
API_TOKEN=
# 自动化运行器识别业务响应码的字段路径，多个用英文逗号分隔。
API_BUSINESS_CODE_PATHS=code
# 自动化运行器判定接口业务成功的响应码，多个用英文逗号分隔；不同项目可改为 0、00、SUCCESS 等。
API_BUSINESS_SUCCESS_CODES=0000
# 自动化运行器判定接口业务失败的响应码，多个用英文逗号分隔；留空时按“出现业务码但不在成功码内”为失败。
API_BUSINESS_FAILURE_CODES=
# 是否启用业务码严格判断；false 时只按 success=false、显式失败码和异常文本判失败。
API_BUSINESS_CODE_STRICT=true

# 是否启用数据库校验能力。
DB_ENABLED=false
# 数据库类型。
DB_TYPE=mysql
# 数据库主机地址。
DB_HOST=
# 数据库端口。
DB_PORT=
# 数据库连接账号。
DB_USER=
# 数据库连接密码。
DB_PASSWORD=
# 数据库名称。
DB_NAME=

# AI 服务提供商标识，例如 openai、azure-openai、aliyun-bailian 或其他 OpenAI 兼容服务。
AI_PROVIDER=aliyun-bailian
# AI 兼容接口基础地址。不要提交真实生产地址或带鉴权参数的 URL。
AI_BASE_URL=https://token-plan.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
# AI 服务访问密钥。只在本地 .env 或 CI Secret 中配置真实值。
AI_API_KEY=
# AI 生成用例使用的模型名称。
AI_MODEL=qwen3.6-flash
# AI 请求超时时间毫秒数。
AI_TIMEOUT_MS=60000
# AI 请求最大重试次数。
AI_MAX_RETRIES=2
# AI 重试间隔毫秒数。
AI_RETRY_DELAY_MS=1000
# 是否启用失败步骤 AI 分析；false 时关闭。
AI_FAILURE_ANALYSIS=true

# Fastify API 服务监听主机；留空时使用 platform.config.json。
SERVER_HOST=127.0.0.1
# Fastify API 服务端口；PORT 优先级高于 SERVER_PORT。
SERVER_PORT=4300
# 部署平台或临时启动时常用端口变量，通常本地留空。
PORT=
# Web dev server 监听主机，WEB_HOST 是非 Vite 别名。
WEB_HOST=0.0.0.0
VITE_WEB_HOST=0.0.0.0
# Web dev server 端口，WEB_PORT 是非 Vite 别名。
WEB_PORT=4301
VITE_WEB_PORT=4301
# Web dev server 的 /api 代理目标。
VITE_DEV_API_PROXY_TARGET=http://localhost:4300
# 前端静态构建或桌面端加载时访问 API 的基础地址；留空时使用当前来源或 URL 参数。
VITE_API_BASE_URL=
# 前端请求超时时间毫秒数。
VITE_APP_REQUEST_TIMEOUT_MS=20000
# 前端 localStorage key。
VITE_APP_STORAGE_KEY=dwt-testing-settings
# 设置页上下文导入请求体大小限制，单位 MB。
VITE_APP_CONTEXT_BODY_LIMIT_MB=5
# AI 资料上传大小限制，单位 MB。
VITE_APP_UPLOAD_MAX_MB=8
# 用例附件上传大小限制，单位 MB。
VITE_APP_CASE_ATTACHMENT_MAX_MB=20
# React StrictMode 开关；true 时启用。
VITE_APP_REACT_STRICT_MODE=false

# 开发前清理端口列表；留空时使用 platform.config.json 中的 server/web 端口。
DEV_PORTS=4300,4301
# 桌面端开发模式加载的 Web dev server 地址。
DWT_DESKTOP_DEV_SERVER_URL=http://127.0.0.1:4301
# 桌面端内置 API 端口，0 表示随机端口。
DWT_DESKTOP_API_PORT=0
# Playwright 浏览器目录；打包桌面端通常由程序自动设置，本地一般留空。
PLAYWRIGHT_BROWSERS_PATH=

# 浏览器是否以无头模式运行。
HEADLESS=false
# Playwright 操作慢放毫秒数。
SLOW_MO=100
# Playwright trace 采集策略。
TRACE=on
# Playwright 视频录制策略。
VIDEO=retain-on-failure
# Playwright 截图采集策略。
SCREENSHOT=only-on-failure
# 是否启用可视化辅助执行模式。
VISUAL_MODE=
# 浏览器视口宽度。留空时使用 platform.config.json 的 browser.defaultViewport.width。
BROWSER_VIEWPORT_WIDTH=1920
# 浏览器视口高度。留空时使用 platform.config.json 的 browser.defaultViewport.height。
BROWSER_VIEWPORT_HEIGHT=1080
# 登录流程等待超时时间毫秒数。
FLOW_LOGIN_TIMEOUT_MS=3000
