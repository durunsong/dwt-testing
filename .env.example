# sit environment config
# Managed by /settings. Do not commit real secrets.

# 后端/报告中展示的品牌名称。
APP_BRAND_NAME=Dowalet
# 后端/报告中展示的产品名称。
APP_PRODUCT_NAME="Dowalet Test"
# 前端页面展示的品牌名称。
VITE_APP_BRAND_NAME=Dowalet
# 前端页面展示的产品名称。
VITE_APP_PRODUCT_NAME="Dowalet Test"
# 当前默认测试环境标识。
TEST_ENV=sit
# Node.js 运行模式。
NODE_ENV=development
# 用户端登录页地址。
USER_LOGIN_URL="https://sit.dowalet.com/user/#/login"
# 注册页面地址
USER_REGISTER_URL="https://sit.dowalet.com/user/#/register"
# 用户端首页地址。
USER_HOME_URL="https://sit.dowalet.com/user/#/"
# 用户端 KYC 页面地址。
USER_KYC_URL=
# 用户端测试账号。
USER_USERNAME=1925344663@qq.com
# 用户端测试密码。
USER_PASSWORD=123456
# 注册时设置的默认密码
USER_REGISTER_PASSWORD=Dy2001298374..
REGISTER_TEST_PHONE=13912345678
# 管理端登录页地址。
ADMIN_LOGIN_URL=https://sit.dowalet.com/admin/
# 管理端首页地址。
ADMIN_HOME_URL=https://sit.dowalet.com/admin/
# 管理端 KYC 审核页地址。
ADMIN_KYC_REVIEW_URL=https://sit.dowalet.com/admin/
# 管理端测试账号。
ADMIN_USERNAME=17803834449
# 管理端测试密码。
ADMIN_PASSWORD=lhy@2025
# 自动生成 KYC 企业名称的前缀。
KYC_ENTERPRISE_NAME_PREFIX=自动化测试企业
# 自动生成营业执照号的前缀。
KYC_LICENSE_NO_PREFIX=AUTO
# KYC 法人姓名测试值。
KYC_LEGAL_PERSON=自动化测试法人
# KYC 法人身份证号测试值。
KYC_ID_CARD_NO=110101199001011234
# KYC 审核备注默认内容。
KYC_REVIEW_REMARK=自动化测试审核通过
# 营业执照上传文件路径。
KYC_BUSINESS_LICENSE_FILE=uploads/business-license.png
# 企业办公场景上传文件路径。
KYC_OFFICE_FILE=uploads/cases/kyc_submit/office-scene.png
# 身份证人像面上传文件路径。
KYC_ID_CARD_FRONT_FILE=uploads/id-card-front.png
# 身份证国徽面上传文件路径。
KYC_ID_CARD_BACK_FILE=uploads/id-card-back.png
# 手持身份证上传文件路径。
KYC_ID_CARD_HANDHELD_FILE=uploads/cases/kyc_submit/id-card-handheld.png
# 居住证明上传文件路径（选填）。
KYC_LIVE_PROVE_FILE=uploads/cases/kyc_submit/live-prove.png
# 是否启用接口测试能力。
API_ENABLED=true
# 接口测试基础地址。
API_BASE_URL=
# 缺失变量补齐：API 地址别名
APP_API_BASE_URL=
DWT_API_BASE_URL=
TEST_API_BASE_URL=
# 接口测试鉴权 token。
API_TOKEN=
# 自动化运行器识别业务响应码的字段路径，多个用英文逗号分隔。
API_BUSINESS_CODE_PATHS=code
# 自动化运行器判定接口业务成功的响应码，多个用英文逗号分隔；不同项目可改为 0、200、SUCCESS 等。
API_BUSINESS_SUCCESS_CODES=0000
# 自动化运行器判定接口业务失败的响应码，多个用英文逗号分隔；留空时按“出现业务码但不在成功码内”为失败。
API_BUSINESS_FAILURE_CODES=
# 是否启用业务码严格判断；false 时只按 success=false、显式失败码和异常文本判失败。
API_BUSINESS_CODE_STRICT=true
# 是否启用数据库校验能力。
DB_ENABLED=true
# 数据库类型。
DB_TYPE=mysql
# 数据库主机地址。
DB_HOST=sit-eks-aurora-cluster.cluster-c1gc08cmin0e.ap-east-1.rds.amazonaws.com
# 数据库端口。
DB_PORT=3306
# 数据库连接账号。
DB_USER=dowalet_user
# 数据库连接密码。
DB_PASSWORD=
# 数据库名称。
DB_NAME=dsb_dowalet
# AI 服务提供商标识。
AI_PROVIDER=zhipu-glm
# AI 兼容接口基础地址。
AI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# AI 服务访问密钥。
AI_API_KEY=
# AI 生成用例使用的模型名称。
AI_MODEL=GLM-4.6V-FlashX
# 缺失变量补齐：AI 请求控制
AI_TIMEOUT_MS=60000
AI_MAX_RETRIES=2
AI_RETRY_DELAY_MS=1000
AI_FAILURE_ANALYSIS=true
# 缺失变量补齐：本地服务端口
SERVER_HOST=127.0.0.1
SERVER_PORT=4300
PORT=
WEB_HOST=0.0.0.0
VITE_WEB_HOST=0.0.0.0
WEB_PORT=4301
VITE_WEB_PORT=4301
VITE_DEV_API_PROXY_TARGET=http://localhost:4300
# 缺失变量补齐：Web 前端运行配置
VITE_API_BASE_URL=
VITE_APP_REQUEST_TIMEOUT_MS=20000
VITE_APP_STORAGE_KEY=dwt-testing-settings
VITE_APP_CONTEXT_BODY_LIMIT_MB=5
VITE_APP_UPLOAD_MAX_MB=8
VITE_APP_CASE_ATTACHMENT_MAX_MB=20
VITE_APP_REACT_STRICT_MODE=false
# 缺失变量补齐：开发与桌面端
DEV_PORTS=4300,4301
DWT_DESKTOP_DEV_SERVER_URL=http://127.0.0.1:4301
DWT_DESKTOP_API_PORT=0
PLAYWRIGHT_BROWSERS_PATH=
# 浏览器是否以无头模式运行。
HEADLESS=false
# Playwright 操作慢放毫秒数。
SLOW_MO=1000
# Playwright trace 采集策略。
TRACE=on
# Playwright 视频录制策略。
VIDEO=retain-on-failure
# Playwright 截图采集策略。
SCREENSHOT=only-on-failure
# 是否启用可视化辅助执行模式。
VISUAL_MODE=
# 浏览器视口宽度。
BROWSER_VIEWPORT_WIDTH=1920
# 浏览器视口高度。
BROWSER_VIEWPORT_HEIGHT=1080
# 登录流程等待超时时间毫秒数。
FLOW_LOGIN_TIMEOUT_MS=15000
